    "version": "0.2.0",
    "configurations": [        
        {
            "name": "Uvicorn Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "app.main:app",
                "--reload",
                "--log-level",
                "debug",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "subProcess": true,
        },
